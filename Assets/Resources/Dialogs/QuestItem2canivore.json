  {
    "type": "QuestionWith3Choices",
    "textCaption": "A <i>Teratophoneus</i> has appeared! \nWhat is <color=orange>Baby Joe's</color> best chance for survival?\n",
    "textName": "",
    "spriteDescript": "",
    "choices": [
      {
        "text": "Hide motionless in vegetation",
