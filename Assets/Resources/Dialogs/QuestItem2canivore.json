        "sprite": "quests/new Q2-Q5 image/q2a1",
        "answerType": "Wrong",
        "afterDialogs": [
          {
            "type": "TextOnly",
            "textCaption": "Uh-oh! The <i>Tetraphoneus</i> actually had a great sense of smell—perfect for finding out where its prey is.",
            "textName": "",
            "spriteDescript": "",
            "choices": []
          },
          {
            "type": "TextOnly",
            "textCaption": "To make it even worse, it was an ambush predator—a type of dinosaur that hides and jumps out at its prey to hunt it down.",
            "textName": "",
            "spriteDescript": "",
            "choices": []
          },
          {
            "type": "PortraitAndText",
            "textCaption": "It sees me!",
            "textName": "<color=orange>Baby Joe</color>",
            "spritePortrait": "Portrait/babyjoe_scray",
            "spriteDescript": "",
            "choices": []
          }
        ]
      },
      {
        "text": "Run in a straight line across open ground",
