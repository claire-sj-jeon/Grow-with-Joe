        "sprite": "quests/new Q2-Q5 image/q2a2",
        "answerType": "NotWrong",
        "afterDialogs": [
          {
            "type": "TextOnly",
            "textCaption": "Almost! You run as fast as you can! \nYou’ve seen some other adult <i>Parasaurolophus</i> before. ",
            "textName": "",
            "spriteDescript": "",
            "choices": []
          },
          {
            "type": "TextOnly",
            "textCaption": "They can outrun the <i>Tetrophoneus</i>, so you can do it too! ...Right...?",
            "textName": "",
            "spriteDescript": "",
            "choices": []
          },
          {
            "type": "TextOnly",
            "textCaption": "Oh no! You’re a juvenile <i>Parasaurolophus</i>, and not as fast as an adult. Running alone is risky.",
            "textName": "",
            "spriteDescript": "",
            "choices": []
          },
          {
            "type": "PortraitAndText",
            "textCaption": "Nghhh... Keep... running...!",
            "textName": "<color=orange>Baby Joe</color>",
            "spritePortrait": "Portrait/babyjoe_scream",
            "spriteDescript": "",
            "choices": []
          }
        ]
      },
      {
        "text": "Call loudly for the group",
        "afterText": "",
        "aftersprite": "",
