{
  "intro": [
    {
      "type": "PortraitAndText",
      "textCaption": "Hi there, explorers!\nI’m <b>Dr. Andrew Farke,</b>\na dinosaur-studying paleontologist. \nNice to meet you!",
      "textName": "Dr. Farke",
      "spritePortrait": "Portrait/dr",
      "spriteDescript": "",
      "choices": []
    },
    {
      "type": "TextOnly",
      "textCaption": "You see that cute little dinosaur over there?  @look \nThat’s<color=orange> “Baby Joe.” </color>",
      "textName": "",
      "spritePortrait": "",
      "spriteDescript": "",
      "choices": []
    },
    {
      "type": "TextOnly",
      "textCaption": "<color=orange>Baby Joe</color> is a <i>Parasaurolophus</i> that lived during the Cretaceous period, in a place we call Utah today. @lookend \n\n\n",
      "textName": "",
      "spritePortrait": "",
      "spriteDescript": "",
      "choices": []
    },
    {
      "type": "PortraitAndText",
      "textCaption": "Today, we’re going on an amazing adventure to learn about <color=orange>ontogeny.</color>",
      "textName": "Dr. Farke",
      "spritePortrait": "Portrait/dr",
      "spriteDescript": "",
      "choices": []
    },
    {
      "type": "PortraitAndText",
      "textCaption": "... That might sound intimidating, but that just means we’re going to learn how animals grow up.",
      "textName": "Dr. Farke",
      "spritePortrait": "Portrait/dr",
      "spriteDescript": "",
      "choices": []
    }
  ],
  "tutorial": [
    {
      "type": "WideImageAndText",
      "textCaption": "In-game, you’re going to have a joystick on the left and a jump button on the right.\n",
