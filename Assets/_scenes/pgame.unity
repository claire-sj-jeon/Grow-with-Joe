--- !u!114 &732594450
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 732594448}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65745d07b72f45447824b036eb2fd691, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::cowsins2D.DialogMenu
  playerDependencies: {fileID: 5773820164468904756}
  root: {fileID: 734694168}
  Textbox: {fileID: 1545700088}
  controllerCamera: {fileID: 4483729059668711454}
  correctSfx: {fileID: 8300000, guid: 16ee27c8ba827394bb99a27f8df35414, type: 3}
  wrongSfx: {fileID: 8300000, guid: 88b2d411f6684484b92158c7063f51e4, type: 3}
  needclearCount: 4
  listDialogintro:
  - type: 0
    textCaption: "Hi there, explorers! I\u2019m Dr. Andrew Farke, a dinosaur-studying
      paleontologist. Nice to meet you!"
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 1
    textCaption: "@look You see that cute little dinosaur over there? That\u2019s<color=orange>
      \u201CBaby Joe.\u201D </color>"
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 1
    textCaption: '@lookend Joe is a <i>Parasaurolophus</i> that lived during the
      Cretaceous period, in a place we call Utah today.



'
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 0
    textCaption: "Today, we\u2019re going on an amazing adventure to learn about
      ontogeny."
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 0
    textCaption: "That might sound intimidating, but that just means we\u2019re going
      to learn how animals grow up."
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  listDialogtutorial:
  - type: 3
    textCaption: "In-game, you\u2019re going to have a joystick on the left and a
      jump button on the right.\n"
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 21300000, guid: b3d0abb9c679b4d4592afb6fb175f1b9, type: 3}
    choices: []
  - type: 3
    textCaption: You can drag the joystick to move around and press the jump button
      to, well, jump!
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 21300000, guid: b3d0abb9c679b4d4592afb6fb175f1b9, type: 3}
    choices: []
  - type: 0
    textCaption: Along the way, <color=orange>Baby Joe</color> might run into some
      other dinosaurs.
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 0
    textCaption: They might even talk to <color=orange>Baby Joe. </color>
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 0
    textCaption: They might even talk to <color=orange>Baby Joe. </color>
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 3
    textCaption: " You can click on the arrow button in the bottom-right corner to
      move on, like you\u2019re doing right now!"
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 21300000, guid: 7deeafe474a594d6d82f7cff1f39fb20, type: 3}
    choices: []
  - type: 0
    textCaption: Along the way, <color=orange>Baby Joe</color> might have some problems
      to solve.
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 3
    textCaption: 'This is where you come in: help <color=orange>Baby Joe</color>
      make decisions as it grows! Baby Joe needs YOUR help to live through his life
      as a baby parasaurolophus.'
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 21300000, guid: 7deeafe474a594d6d82f7cff1f39fb20, type: 3}
    choices: []
  - type: 3
    textCaption: "Go ahead and click one of the three choices. Some might be partially
      correct, but remember\u2014only ONE is the best path to survival. Look closely
      and choose the most scientifically accurate one!"
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 21300000, guid: 7deeafe474a594d6d82f7cff1f39fb20, type: 3}
    choices: []
  - type: 0
    textCaption: "Now, I hope you're ready. Let\u2019s start this incredible journey!"
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 0
    textCaption: See you 75 million years ago!
    textName: Dr. Farke
    spritePortrait: {fileID: 21300000, guid: 077576c1c828e6645906a9455203def8, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
  listDialogEnd:
  - type: 1
    textCaption: 'The season changes. Food becomes scarce. '
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 0}
    choices: []
  - type: 0
    textCaption: I need to find food... where should I go?
    textName: baby joe
    spritePortrait: {fileID: 21300000, guid: 6103bb4126bdc63448e213233d047dc5, type: 3}
    spriteDescript: {fileID: 0}
    choices:
    - text: 1
      afterText: ...
      aftersprite: {fileID: 0}
      sprite: {fileID: 784408457, guid: b58e396a48b7db24983f2f01bcf136e0, type: 3}
      answerType: 0
      afterDialogs: []
    - text: 2
      afterText: ...
      aftersprite: {fileID: 0}
      sprite: {fileID: -1651673544, guid: 8575bd0345c2226469147a4d1850a833, type: 3}
      answerType: 1
      afterDialogs: []
    - text: 3
      afterText: ...
      aftersprite: {fileID: 0}
      sprite: {fileID: -1651673544, guid: 8575bd0345c2226469147a4d1850a833, type: 3}
      answerType: 2
      afterDialogs: []
  - type: 4
    textCaption: Question
    textName: 
    spritePortrait: {fileID: 0}
    spriteDescript: {fileID: 0}
    choices:
    - text: Follow herd to wetter floodplain
      afterText: 
      aftersprite: {fileID: 0}
      sprite: {fileID: 21300000, guid: 945be35aa39c444f79c10b0f6291ab64, type: 3}
      answerType: 0
      afterDialogs:
      - type: 1
        textCaption: Following the herd leads to abundant food and safer conditions.
        textName: 
        spritePortrait: {fileID: 0}
        spriteDescript: {fileID: 0}
        choices: []
      - type: 0
        textCaption: "There\u2019s so much to eat! I love my herd!"
        textName: 
        spritePortrait: {fileID: 21300000, guid: 6103bb4126bdc63448e213233d047dc5, type: 3}
        spriteDescript: {fileID: 0}
        choices: []
    - text: Wander into upland dry forest
      afterText: 
      aftersprite: {fileID: 0}
      sprite: {fileID: 21300000, guid: 0567341e1c23d4dc2af408f5695e6ff3, type: 3}
      answerType: 1
      afterDialogs:
      - type: 1
        textCaption: The dry forest lacks enough vegetation to sustain you.
        textName: 
        spritePortrait: {fileID: 0}
        spriteDescript: {fileID: 0}
        choices: []
      - type: 0
        textCaption: Thirsty...food...
        textName: baby joe
        spritePortrait: {fileID: 21300000, guid: 6103bb4126bdc63448e213233d047dc5, type: 3}
