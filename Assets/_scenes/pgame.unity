      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[1].afterDialogs.Array.data[3].textName
      value: <color=orange>Baby Joe</color>
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[2].afterDialogs.Array.data[0].textName
      value: Dr. Farke
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[2].afterDialogs.Array.data[1].textName
      value: <color=orange>Baby Joe</color>
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[0].afterDialogs.Array.data[0].textCaption
      value: "Uh-oh! The <i>Tetraphoneus</i> actually had a great sense of smell\u2014perfect
        for finding out where its prey is."
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[0].afterDialogs.Array.data[1].textCaption
      value: "To make it even worse, it was an ambush predator\u2014a type of dinosaur
        that hides and jumps out at its prey to hunt it down."
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[0].afterDialogs.Array.data[2].textCaption
      value: It sees me!
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[1].afterDialogs.Array.data[0].textCaption
      value: "Almost! You run as fast as you can! You\u2019ve seen some other adult
        <i>Parasaurolophus</i> before. "
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[1].afterDialogs.Array.data[1].textCaption
      value: "They can outrun the <i>Tetrophoneus</i>, so you can do it too! \u2026Right\u2026?"
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[1].afterDialogs.Array.data[2].textCaption
      value: "Oh no! You\u2019re a juvenile <i>Parasaurolophus</i>, and not as fast
        as an adult. Running alone is risky."
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[1].afterDialogs.Array.data[3].textCaption
      value: Nghhh... Keep... running...!
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[2].afterDialogs.Array.data[0].textCaption
      value: Correct! Your call alerts nearby adults, who move to protect you.
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[3].choices.Array.data[2].afterDialogs.Array.data[1].textCaption
      value: Whew! They heard me!
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
