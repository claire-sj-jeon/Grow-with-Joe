--- !u!114 &732594450
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 732594448}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65745d07b72f45447824b036eb2fd691, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::cowsins2D.DialogMenu
  playerDependencies: {fileID: 5773820164468904756}
  root: {fileID: 734694168}
  Textbox: {fileID: 1545700088}
  correctSfx: {fileID: 8300000, guid: 16ee27c8ba827394bb99a27f8df35414, type: 3}
  wrongSfx: {fileID: 8300000, guid: 88b2d411f6684484b92158c7063f51e4, type: 3}
  needclearCount: 4
  listDialogintro:
  - type: 0
    textCaption: "\uC548\uB155 \uB098\uB294 \uD30C\uB77C\uC0AC\uC6B0  \uD480\uB974\uC2A4
      \uACF5\uB8E1\uC774\uC57C. \n\uB098 \uAE38\uC744 \uC783\uC5B4 \uBC84\uB9B0\uAC83
      \uAC19\uC544. \uC5EC\uAE30\uC11C \uC0B4\uC544 \uB0A8\uC544\uC57C \uD558\uB294\uB370"
    textName: "\uD30C\uB77C\uD30C\uB77C"
    spritePortrait: {fileID: 21300000, guid: ecd359c045351424082d2ba03ec132df, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
    isDim: 1
  - type: 3
    textCaption: "\uAC8C\uC784 \uD558\uB294 \uBC29\uBC95\uC744 \uC54C\uB824\uC904\uAC8C.
      \n\uC88C\uC6B0\uB85C \uC774\uB3D9\uD558\uBA74\uC11C, \uC810\uD504\uB97C \uD560\uC218
      \uC788\uC5B4. \n\uAC01 \uC9C0\uC5ED\uC5D0 \uC788\uB294 \uC544\uC774\uD15C\uB4E4\uC744
      \uCC3E\uC544\uBD10, \uB108\uD55C\uD0DC \uD544\uC694\uD560\uC218\uB3C4 \uC788\uC5B4. "
    textName: 
    spritePortrait: {fileID: 21300000, guid: ecd359c045351424082d2ba03ec132df, type: 3}
    spriteDescript: {fileID: 21300000, guid: 4063a471a5d62d345b201c683a172541, type: 3}
    choices: []
    isDim: 1
  listDialogEnd:
  - type: 0
    textCaption: "\uC790 \uC9C0\uAE08\uAE4C\uC9C0 \uC798 \uD574\uC654\uC5B4, \uACF5\uB8E1
      \uBC15\uC0AC\uAC00 \uB2E4 \uB418\uC5C8\uAD6C\uB098"
    textName: "\uD30C\uB77C\uD30C\uB77C"
    spritePortrait: {fileID: 21300012, guid: ecd359c045351424082d2ba03ec132df, type: 3}
    spriteDescript: {fileID: 0}
    choices: []
    isDim: 0
  - type: 4
    textCaption: "\uB5A0\uB0A0\uB54C \uC6B0\uB9AC\uAC00 \uC900\uBC30 \uD574\uC57C
      \uD560\uAC83\uC740?"
    textName: "\uD30C\uB77C\uD30C\uB77C"
    spritePortrait: {fileID: 21300012, guid: ecd359c045351424082d2ba03ec132df, type: 3}
    spriteDescript: {fileID: 0}
    choices:
    - text: "\uC6D4\uB3D9\uC900\uBE44"
      afterText: "\uADF8\uB798 \uB9DE\uC558\uC5B4"
      sprite: {fileID: 21300000, guid: a2d68081d156f704bb974b65c4ba11c6, type: 3}
      answerType: 0
    - text: "\uBA39\uC744\uAC83\uC900\uBE44"
      afterText: "\uBA39\uC744\uAC74 \uC5EC\uAE30 \uC774\uC81C \uC5C6\uC5B4"
      sprite: {fileID: 21300000, guid: 2797cf66f22b3b848ae0e681796df89d, type: 3}
      answerType: 1
    - text: "\uB098\uD63C\uC790 \uC9D0\uCC59\uAE30\uAE30"
      afterText: "\uBB34\uB9AC\uC5D0\uC11C \uB098\uAC00\uBA74 \uC704\uD5D8\uD574"
      sprite: {fileID: 21300000, guid: 8708d80070522a043a1ab6a2b2775382, type: 3}
      answerType: 2
    isDim: 0
