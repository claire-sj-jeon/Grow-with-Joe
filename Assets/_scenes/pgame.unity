      propertyPath: listDialog.Array.data[2].choices.Array.data[2].afterDialogs.Array.data[3].textName
      value: <color=orange>Baby Joe</color>
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[0].afterDialogs.Array.data[0].textCaption
      value: Correct! Staying within the herd offers protection through numbers.
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[0].afterDialogs.Array.data[1].textCaption
      value: I feel safe...
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[1].afterDialogs.Array.data[0].textCaption
      value: "Uh-oh! The edge of the herd leaves you exposed to predators\u2026!"
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[1].afterDialogs.Array.data[1].textCaption
      value: "I feel like something\u2019s watching me\u2026!"
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[1].afterDialogs.Array.data[2].textCaption
      value: "And\u2026NOW!"
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[1].afterDialogs.Array.data[3].textCaption
      value: "Oh no! The <i>Teratophoneus</i> found you sleeping! Meeting a predator
        while open to danger isn\u2019t the best idea\u2026!"
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[1].afterDialogs.Array.data[4].textCaption
      value: GAH!!! Where did you come from!!!
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[2].afterDialogs.Array.data[0].textCaption
      value: Almost! The water keeps you cool, but footing is unstable and danger
        lurks.
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[2].afterDialogs.Array.data[1].textCaption
      value: "I can\u2019t get comfortable..."
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[2].afterDialogs.Array.data[2].textCaption
      value: "Har har har\u2026 thanks for the free food!"
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
      propertyPath: listDialog.Array.data[2].choices.Array.data[2].afterDialogs.Array.data[3].textCaption
      value: "Oh no no no\u2014!"
      objectReference: {fileID: 0}
    - target: {fileID: 2775039833176612092, guid: 4f3e9e1e9f8f85041b0df700969cac10, type: 3}
